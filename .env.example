# ENVIRONMENT must be production on Render. Do not commit a real .env file.
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET
DATABASE_PATH=./data/helix_studio.db
PRIVATE_UPLOAD_DIR=./data/private_payment_proofs

# For development testing only: verification codes will print in the terminal.
# In production: EMAIL_MODE=smtp and configure ALL SMTP_* values.
EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPPORT_EMAIL=

# Never use placeholder credentials for a live website.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Both payment methods start disabled until securely configured.
# Do NOT use the sample string below as a real Bitcoin address.
BTC_ADDRESS=
GIFT_CARD_ENABLED=0
# Gift-card instructions must specify an authorized redemption/verification process.
# Never ask customers for a gift-card PIN or redemption number.
GIFT_CARD_INSTRUCTIONS=

# The sample site uses prepaid 12-month access, without auto renewal.
MEMBERSHIP_MONTHS=12
